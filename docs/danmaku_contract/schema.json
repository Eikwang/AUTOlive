          "default": false,
          "title": "Is Anchor",
          "type": "boolean"
        }
      },
      "required": [
        "user_name",
        "content"
      ],
      "title": "DanmuPayload",
      "type": "object"
    },
    "DanmuSendRequestPayload": {
      "description": "DANMU_SEND_REQUEST：发送命令载荷（AUTOlive→引擎）\n\nrequest_id 由 AUTOlive 生成并保证唯一；重复 request_id 直接拒绝并回执上次结果（R18 幂等）。",
      "properties": {
        "type": {
          "const": "DANMU_SEND_REQUEST",
          "default": "DANMU_SEND_REQUEST",
          "title": "Type",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "content"
      ],
      "title": "DanmuSendRequestPayload",
      "type": "object"
    },
    "DanmuSendResultPayload": {
      "description": "DANMU_SEND_RESULT：发送回执载荷（引擎→AUTOlive）\n\n- status=dry_run 非成功语义（AUTOlive 不得误判已实发——DX-F1/R11）\n- status=failed/unknown 时 reason 三段式必填（复用 FailureInfo）\n- sent_at+content 供 AUTOlive 自发声回环去重（F8/R39）",
      "properties": {
        "type": {
          "const": "DANMU_SEND_RESULT",
          "default": "DANMU_SEND_RESULT",
          "title": "Type",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SendStatus"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "fix_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fix Hint"
        },
        "docs_anchor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Docs Anchor"
        },
        "sent_at": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sent At"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        }
      },
      "required": [
        "request_id",
        "status"
      ],
      "title": "DanmuSendResultPayload",
      "type": "object"
    },
    "EngineStatusPayload": {
