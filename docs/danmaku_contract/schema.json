{
  "$defs": {
    "BackpressurePayload": {
      "description": "BACKPRESSURE：背压丢弃计数（窗口级，非累计）",
      "properties": {
        "type": {
          "const": "BACKPRESSURE",
          "default": "BACKPRESSURE",
          "title": "Type",
          "type": "string"
        },
        "window_start": {
          "title": "Window Start",
          "type": "integer"
        },
        "window_end": {
          "title": "Window End",
          "type": "integer"
        },
        "dropped_by_type": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Dropped By Type",
          "type": "object"
        }
      },
      "required": [
        "window_start",
        "window_end",
        "dropped_by_type"
      ],
      "title": "BackpressurePayload",
      "type": "object"
    },
    "Category": {
      "description": "消息大类：业务消息 / 系统状态消息 / 下行命令消息（AutoDanmu 契约 v1 additive 扩展，ADR-002）",
      "enum": [
        "business",
        "system",
        "command"
      ],
      "title": "Category",
      "type": "string"
    },
    "DanmuPayload": {
      "description": "DANMU：普通弹幕",
