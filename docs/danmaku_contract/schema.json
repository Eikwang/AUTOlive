    "Envelope": {
      "description": "统一消息信封\n\nAttributes:\n    contract_version: 契约版本（additive-only 演进，消费者忽略未知字段）\n    category: business / system 大类（AUTOlive 按此分流，不做字符串前缀判断）\n    type: 消息类型（BusinessType 或 SystemType 值）\n    platform: 平台标识（bilibili/douyu/huya/kuaishou/douyin/wechat_channels）\n    room_id: 房间 ID（平台原生 ID 字符串）\n    seq: 房间内单调递增序号（顺序保证与缺口检测的依据）\n    timestamp: 平台消息时间戳（秒级；无平台时间戳时为引擎接收时刻，测量口径见契约文档）\n    engine: 活跃引擎标识\n    msg_id: 平台原生消息 ID（跨路线语义去重键；平台提供时必填）",
      "properties": {
        "contract_version": {
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "platform": {
          "title": "Platform",
          "type": "string"
        },
        "room_id": {
          "title": "Room Id",
          "type": "string"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "integer"
        },
        "engine": {
          "title": "Engine",
          "type": "string"
        },
        "msg_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Msg Id"
        },
        "protocol_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol Version"
        }
      },
      "required": [
        "category",
        "type",
        "platform",
        "room_id",
        "seq",
        "timestamp",
        "engine"
      ],
      "title": "Envelope",
      "type": "object"
    },
    "FailureInfo": {
      "description": "失败三段式（失败类消息强制字段，非空校验）\n\nAttributes:\n    reason_code: 机器可读原因码，形如 ``douyin.companion.version_mismatch``\n    fix_hint: 人类可读修复指引\n    docs_anchor: 文档锚点，指向平台风控手册或运维手册，如\n        ``docs/platforms/douyin/runbook.md#version-mismatch``",
      "properties": {
        "reason_code": {
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        },
        "fix_hint": {
          "minLength": 1,
          "title": "Fix Hint",
          "type": "string"
        },
        "docs_anchor": {
          "minLength": 1,
          "title": "Docs Anchor",
          "type": "string"
        }
      },
      "required": [
        "reason_code",
        "fix_hint",
        "docs_anchor"
      ],
      "title": "FailureInfo",
      "type": "object"
    },
    "GapPayload": {
      "description": "GAP：消息缺口标记（必达；下播期间缺失不计 GAP，崩溃恢复拆分为近似区间）",
