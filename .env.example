# ===========================================
# Luna AI 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ===========================================

# Python 路径（可选）
# PYTHONPATH=.

# CUDA 设备（可选，默认使用 GPU 0）
# CUDA_VISIBLE_DEVICES=0

# 代理配置（可选）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# 日志级别（DEBUG/INFO/WARNING/ERROR）
# LOG_LEVEL=INFO

# API 密钥（请勿提交到 Git）
# OPENAI_API_KEY=sk-xxx
# GEMINI_API_KEY=xxx
# ZHIPU_API_KEY=xxx
# ELEVENLABS_API_KEY=xxx
